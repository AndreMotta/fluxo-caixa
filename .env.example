# Copie para .env e troque TODOS os valores (use só letras e números nas senhas: elas entram em URLs).
# Nunca versione o .env. Em produção, todos estes valores vêm do Key Vault (Managed Identity).
POSTGRES_PASSWORD=troque-postgres-123

# Banco: um usuário de migração (dono, DDL) e um de execução (DML mínimo) por serviço
LANC_DB_MIGRACAO_PASSWORD=troqueLancMigracao123
LANC_DB_PASSWORD=troqueLancamentos123
CONS_DB_MIGRACAO_PASSWORD=troqueConsMigracao123
CONS_DB_PASSWORD=troqueConsolidado123

# Broker: admin (só topologia/console) + um usuário por serviço
RABBITMQ_USER=fluxo
RABBITMQ_PASSWORD=troqueRabbit123
RABBITMQ_LANC_PASSWORD=troqueRabbitLanc123
RABBITMQ_CONS_PASSWORD=troqueRabbitCons123

REDIS_PASSWORD=troqueRedis123

# Chaves de assinatura (Ed25519, assimétricas). NÃO preencha à mão: `make env` gera pares novos
# e acrescenta as linhas abaixo ao .env (para trocar depois: `make chaves`). Nenhum segredo de
# assinatura é compartilhado entre serviços:
#   EVENTOS_CHAVE_PRIVADA -> só o serviço de Lançamentos (assina os eventos)
#   EVENTOS_CHAVE_PUBLICA -> só o Consolidado (confere; não consegue assinar)
#   IDP_CHAVE_PRIVADA     -> só o IdP local (container idp-local) e o e2e (emitem tokens)
#   IDP_CHAVE_PUBLICA     -> os dois serviços (conferem tokens; não conseguem emitir)
# Em produção os tokens vêm do IdP corporativo (RS256 + JWKS) e as chaves ficam no Key Vault.
